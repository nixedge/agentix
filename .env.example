# Shared persistent search index for ingest and mcp-server.
# Default: $XDG_DATA_HOME/agentix/index, or $HOME/.local/share/agentix/index.
# AGENTIX_LANCE_PATH=/absolute/path/to/agentix-index

# Local embedding service/model. Model and dimensions are checked against the stored schema.
# OLLAMA_HOST=http://127.0.0.1:11434
# EMBED_MODEL=hf.co/jinaai/jina-code-embeddings-1.5b-GGUF:Q8_0
# EMBED_DIMENSIONS=1536
# LANCE_NPROBES=20
# LANCE_EF=100
# PROJECTS=project-a,project-b

# Remote shared storage: use instead of AGENTIX_LANCE_PATH on laptop MCP/ingesters.
# AGENTIX_STORE_URL=http://index-host:8091
# Token settings are optional for LAN access; set them only if the server enables auth.
# AGENTIX_STORE_TOKEN_FILE=/run/secrets/agentix-store-token
# AGENTIX_STORE_TOKEN=<runtime alternative; do not set both credential sources>
# Server listener defaults: AGENTIX_STORE_HOST=127.0.0.1, AGENTIX_STORE_PORT=8091
