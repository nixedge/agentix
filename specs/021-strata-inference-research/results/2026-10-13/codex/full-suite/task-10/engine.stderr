#[test]
fn independent_memory_tiers_and_checked_totals() -> TestResult {
    let host = Reservations {
        weights: 70,
        context: 10,
        scratch: 5,
        staging: 2,
        lookup_cache: 3,
        headroom: 10,
    };
    let device = Reservations {
        weights: 10,
        context: 4,
        ..Reservations::default()
    };
    let admitted = admit(100, 24, host, device)?;
    assert_eq!(admitted.host_remaining, 0);
    assert_eq!(admitted.device_remaining, 10);
    assert_eq!(admitted.expert_slots(3, 99)?, 3);
    assert_eq!(admitted.expert_slots(3, 2)?, 2);
    assert!(admitted.expert_slots(0, 1).is_err());
    assert!(matches!(
        admit(99, 999, host, device),
        Err(Error::Capacity("host RAM"))
    ));
    assert!(matches!(
        admit(999, 13, host, device),
        Err(Error::Capacity("device VRAM"))
    ));
    assert!(matches!(
        Reservations {
            weights: u64::MAX,
            context: 1,
            ..Reservations::default()
        }
        .total(),
        Err(Error::Overflow)
    ));
    Ok(())
}

#[test]
fn context_admission_preserves_requested_output_and_never_truncates() -> TestResult {
    assert_eq!(
        admit_context(3072, 1024, 4096)?,
        agentix_qwen::budget::ContextAdmission {
            prompt_tokens: 3072,
            requested_output_tokens: 1024,
            total_tokens: 4096,
            remaining_tokens: 0,
        }
    );
    assert!(matches!(
        admit_context(3073, 1024, 4096),
        Err(Error::Capacity("context window"))
    ));
    assert!(matches!(admit_context(1, 0, 4096), Err(Error::Invalid(_))));
    assert!(matches!(
        admit_context(usize::MAX, 1, usize::MAX),
        Err(Error::Overflow)
    ));
    Ok(())
}
    pub total_tokens: usize,
    pub remaining_tokens: usize,
}

/// Admits a rendered prompt and the caller's full requested generation bound.
/// This never truncates the prompt or silently reduces `max_new_tokens`.
pub fn admit_context(
    prompt_tokens: usize,
    max_new_tokens: usize,
    context_limit: usize,
) -> Result<ContextAdmission> {
    if prompt_tokens == 0 || max_new_tokens == 0 || context_limit == 0 {
        return Err(Error::Invalid(
            "empty prompt, output bound, or context limit",
        ));
    }
    let total_tokens = prompt_tokens
        .checked_add(max_new_tokens)
        .ok_or(Error::Overflow)?;
    let remaining_tokens = context_limit
        .checked_sub(total_tokens)
        .ok_or(Error::Capacity("context window"))?;
    Ok(ContextAdmission {
        prompt_tokens,
        requested_output_tokens: max_new_tokens,
        total_tokens,
        remaining_tokens,
    })
}

