    backend::{CompletionStream, InferBackend, LoadedModel},
    Capability, CompletionChunk, CompletionMessage, CompletionRequest, FinishReason, InferError,
    ModelFormat, ModelInfo,
};
use std::{num::NonZeroU32, path::Path, sync::Arc};

