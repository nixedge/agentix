        if req.stop.iter().any(|s| piece.contains(s.as_str())) {
            let _ = tx.send(Ok(CompletionChunk::new(
                String::new(),
                Some(FinishReason::Stop),
            )));
            return;
        }

        if tx.send(Ok(CompletionChunk::new(piece, None))).is_err() {
            // Client disconnected
            return;
        }

        if i == max_new - 1 {
