codex
The actual local chat route is the Unix-socket proxy. Its response connection driver is spawned detached, while the returned body only owns Hyper’s incoming response. I’ll tie the driver task to body consumption: when the client drops the stream, the forwarding task will stop and abort the backend connection driver, which closes the socket and lets the llama generation loop observe its chunk receiver closing. The llama backend already exits generation when chunk delivery fails.
apply patch
patch: completed
/tmp/nix-shell.zmPdwz/agentix-bench-26812-1791933406284697743/task-08/agentix-daemon/src/gateway/proxy.rs
diff --git a/agentix-daemon/src/gateway/proxy.rs b/agentix-daemon/src/gateway/proxy.rs
index 9420c4320d38acf1432d08aaceab1e568fca7fda..b9e432eefcc7271f19d9c61ae266717bc74d0a03
--- a/agentix-daemon/src/gateway/proxy.rs
+++ b/agentix-daemon/src/gateway/proxy.rs
@@ -46,8 +46,10 @@
         }
     };
 
-    // Drive the connection in the background
-    tokio::spawn(async move {
+    // Drive the connection in the background. Keep the task handle with the
+    // response forwarding task so dropping the downstream body also closes
+    // the backend connection and cancels its generation.
+    let connection = tokio::spawn(async move {
         if let Err(e) = conn.await {
             tracing::debug!("backend connection closed: {e}");
         }
@@ -92,12 +94,28 @@
         }
     };
 
-    // Convert hyper response to axum response, preserving status + headers + streaming body
+    // Convert hyper response to axum response, preserving status + headers + streaming body.
+    // The forwarding task owns the incoming body and connection handle. If the
+    // client disconnects, the receiver is dropped, the send fails, and aborting
+    // the driver closes the Unix socket immediately.
     let (parts, incoming) = hyper_resp.into_parts();
+    let (body_tx, body_rx) = tokio::sync::mpsc::channel(1);
+    tokio::spawn(async move {
+        let mut incoming = Body::new(incoming).into_data_stream();
+        while let Some(frame) = incoming.next().await {
+            if body_tx.send(frame).await.is_err() {
+                break;
+            }
+        }
+        connection.abort();
+    });
+
     let mut resp = Response::builder().status(parts.status);
     for (name, value) in &parts.headers {
         resp = resp.header(name, value);
     }
-    resp.body(Body::new(incoming))
+    resp.body(Body::from_stream(tokio_stream::wrappers::ReceiverStream::new(
+        body_rx,
+    )))
         .unwrap_or_else(|e| (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()).into_response())
 }

