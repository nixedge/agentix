fn apply_chat_template(
    model: &LlamaModel,
    messages: &[CompletionMessage],
) -> Result<String, String> {
    use llama_cpp_2::model::LlamaChatMessage;

    let tmpl = model
        .chat_template(None)
        .map_err(|e| format!("chat_template: {e:?}"))?;

    let chat: Vec<LlamaChatMessage> = messages
        .iter()
