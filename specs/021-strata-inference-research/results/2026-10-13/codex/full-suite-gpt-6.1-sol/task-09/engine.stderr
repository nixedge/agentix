use crate::{Error, Result};
use std::{
    collections::HashMap,
    fs::File,
    os::unix::fs::FileExt,
    path::{Component, Path, PathBuf},
};

const MAX_FLOAT_VECTOR_ELEMENTS: usize = 1_000_000;

/// Parsed SafeTensors file header and the open read-only source file.
pub struct SafeTensorFile {
    file: File,
    metadata: safetensors::tensor::Metadata,
    data_offset: u64,
}

impl SafeTensorFile {
    /// Parses the bounded SafeTensors header and validates its full data extent.
    /// Tensor metadata deserialization checks all ranges and dtype/shape sizes.
    pub fn open(file: File) -> Result<Self> {
        let file_metadata = file.metadata()?;
        if !file_metadata.is_file() || file_metadata.len() < 8 {
            return Err(Error::Invalid("SafeTensors source is not a regular file"));
        }
        let mut size_prefix = [0_u8; 8];
        file.read_exact_at(&mut size_prefix, 0)?;
        let header_len = usize::try_from(u64::from_le_bytes(size_prefix))
            .map_err(|_| Error::Invalid("SafeTensors header is too large"))?;
        // Safetensors 0.8 uses this same hard limit for its whole-buffer parser.
        const MAX_HEADER_LEN: usize = 100_000_000;
        if header_len > MAX_HEADER_LEN {
            return Err(Error::Invalid("SafeTensors header is too large"));
        }
        let header_file_offset = 8_u64;
        let header_end = header_file_offset
            .checked_add(u64::try_from(header_len).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        if header_end > file_metadata.len() {
            return Err(Error::Invalid("truncated SafeTensors header"));
        }
        let mut header = Vec::new();
        header
            .try_reserve_exact(header_len)
            .map_err(|_| Error::Capacity("SafeTensors header"))?;
        header.resize(header_len, 0);
        file.read_exact_at(&mut header, header_file_offset)?;
        let metadata = serde_json::from_slice::<safetensors::tensor::Metadata>(&header)
            .map_err(|_| Error::Invalid("invalid SafeTensors file metadata"))?;
        let data_offset = 8_u64
            .checked_add(u64::try_from(header_len).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        let expected_file_len = data_offset
            .checked_add(u64::try_from(metadata.data_len()).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        if expected_file_len != file_metadata.len() {
            return Err(Error::Invalid("SafeTensors payload length mismatch"));
        }
        Ok(Self {
            file,
            metadata,
            data_offset,
        })
    }

    /// Opens one rank-two BF16 tensor as a bounded on-demand row reader.
    pub fn bf16_rows(
        &self,
        tensor_name: &str,
        expected_shape: [usize; 2],
        cache_bytes: usize,
    ) -> Result<Bf16Rows> {
        let info = self
            .metadata
            .info(tensor_name)
            .ok_or(Error::Invalid("SafeTensors tensor is missing"))?;
        if info.dtype != safetensors::Dtype::BF16 || info.shape.as_slice() != expected_shape {
            return Err(Error::Invalid("SafeTensors BF16 tensor shape mismatch"));
        }
        let row_bytes = expected_shape[1].checked_mul(2).ok_or(Error::Overflow)?;
        let tensor_offset = self
            .data_offset
            .checked_add(u64::try_from(info.data_offsets.0).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        let store = RowStore::new(
            self.file.try_clone()?,
            tensor_offset,
            u64::try_from(expected_shape[0]).map_err(|_| Error::Overflow)?,
            row_bytes,
            cache_bytes,
        )?;
        Ok(Bf16Rows {
            store,
            row_width: expected_shape[1],
        })
    }

    /// Opens one rank-two F32/F16/BF16 tensor as bounded rows decoded to F32.
    pub fn float_rows(
        &self,
        tensor_name: &str,
        expected_shape: [usize; 2],
        cache_bytes: usize,
    ) -> Result<FloatRows> {
        let info = self
            .metadata
            .info(tensor_name)
            .ok_or(Error::Invalid("SafeTensors tensor is missing"))?;
        let (encoding, element_bytes) = match info.dtype {
            safetensors::Dtype::F32 => (FloatEncoding::F32, 4_usize),
            safetensors::Dtype::F16 => (FloatEncoding::F16, 2_usize),
            safetensors::Dtype::BF16 => (FloatEncoding::BF16, 2_usize),
            _ => return Err(Error::Invalid("unsupported SafeTensors float dtype")),
        };
        if expected_shape.contains(&0) || info.shape.as_slice() != expected_shape {
            return Err(Error::Invalid("SafeTensors float tensor shape mismatch"));
        }
        let row_bytes = expected_shape[1]
            .checked_mul(element_bytes)
            .ok_or(Error::Overflow)?;
        let tensor_offset = self
            .data_offset
            .checked_add(u64::try_from(info.data_offsets.0).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        let store = RowStore::new(
            self.file.try_clone()?,
            tensor_offset,
            u64::try_from(expected_shape[0]).map_err(|_| Error::Overflow)?,
            row_bytes,
            cache_bytes,
        )?;
        Ok(FloatRows {
            store,
            row_width: expected_shape[1],
            encoding,
        })
    }

    /// Reads one bounded rank-one F32/F16/BF16 tensor as finite F32 values.
    pub fn float_vector(&self, tensor_name: &str, expected_len: usize) -> Result<Vec<f32>> {
        if expected_len == 0 || expected_len > MAX_FLOAT_VECTOR_ELEMENTS {
            return Err(Error::Invalid("SafeTensors float vector exceeds bounds"));
        }
        let info = self
            .metadata
            .info(tensor_name)
            .ok_or(Error::Invalid("SafeTensors tensor is missing"))?;
        if info.shape.as_slice() != [expected_len] {
            return Err(Error::Invalid("SafeTensors float vector shape mismatch"));
        }
        let (encoding, element_bytes) = match info.dtype {
            safetensors::Dtype::F32 => (FloatEncoding::F32, 4_usize),
            safetensors::Dtype::F16 => (FloatEncoding::F16, 2_usize),
            safetensors::Dtype::BF16 => (FloatEncoding::BF16, 2_usize),
            _ => return Err(Error::Invalid("unsupported SafeTensors float dtype")),
        };
        let byte_len = expected_len
            .checked_mul(element_bytes)
            .ok_or(Error::Overflow)?;
        let offset = self
            .data_offset
            .checked_add(u64::try_from(info.data_offsets.0).map_err(|_| Error::Overflow)?)
            .ok_or(Error::Overflow)?;
        let mut bytes = Vec::new();
        bytes
            .try_reserve_exact(byte_len)
            .map_err(|_| Error::Capacity("SafeTensors float vector bytes"))?;
        bytes.resize(byte_len, 0);
        self.file.read_exact_at(&mut bytes, offset)?;
        let mut values = Vec::new();
        values
            .try_reserve_exact(expected_len)
            .map_err(|_| Error::Capacity("SafeTensors float vector"))?;
        for chunk in bytes.chunks_exact(element_bytes) {
            let value = match encoding {
                FloatEncoding::F32 => f32::from_le_bytes(
                    chunk
                        .try_into()
                        .map_err(|_| Error::Invalid("invalid SafeTensors F32 vector"))?,
                ),
                FloatEncoding::F16 => f16_to_f32(u16::from_le_bytes([chunk[0], chunk[1]])),
                FloatEncoding::BF16 => {
                    f32::from_bits(u32::from(u16::from_le_bytes([chunk[0], chunk[1]])) << 16)
                }
            };
            if !value.is_finite() {
                return Err(Error::Invalid("SafeTensors float vector is non-finite"));
            }
            values.push(value);
        }
    BF16,
}

/// Bounded F32/F16/BF16 source rows decoded to finite F32 values on request.
pub struct FloatRows {
    store: RowStore,
    row_width: usize,
    encoding: FloatEncoding,
}

impl FloatRows {
    pub fn row_width(&self) -> usize {
        self.row_width
    }

    pub fn rows(&self) -> u64 {
        self.store.rows
    }

    pub fn stats(&self) -> Stats {
        self.store.stats()
    }

    pub fn read_f32_row(&mut self, row_id: u64, output: &mut [f32]) -> Result<()> {
        if output.len() != self.row_width {
            return Err(Error::Invalid("source float output row width mismatch"));
        }
        let bytes = self.store.read(row_id)?;
        match self.encoding {
            FloatEncoding::F32 => {
                for (value, chunk) in output.iter_mut().zip(bytes.chunks_exact(4)) {
                    *value = f32::from_bits(u32::from_le_bytes(
                        chunk
                            .try_into()
                            .map_err(|_| Error::Invalid("invalid SafeTensors F32 row"))?,
                    ));
                }
            }
            FloatEncoding::F16 => {
                for (value, chunk) in output.iter_mut().zip(bytes.chunks_exact(2)) {
                    let bits = u16::from_le_bytes([chunk[0], chunk[1]]);
                    *value = f16_to_f32(bits);
                }
            }
            FloatEncoding::BF16 => {
                for (value, chunk) in output.iter_mut().zip(bytes.chunks_exact(2)) {
                    let bits = u16::from_le_bytes([chunk[0], chunk[1]]);
                    *value = f32::from_bits(u32::from(bits) << 16);
                }
            }
        }
        if output.iter().any(|value| !value.is_finite()) {
            return Err(Error::Invalid("source float row contains non-finite value"));
        }
        Ok(())
    }
}

fn f16_to_f32(bits: u16) -> f32 {
    let sign = u32::from(bits & 0x8000) << 16;
    let exponent = u32::from((bits >> 10) & 0x1f);
    let fraction = u32::from(bits & 0x03ff);
    let f32_bits = match exponent {
        0 if fraction == 0 => sign,
        0 => {
            let mut mantissa = fraction;
            let mut shifts = 0_u32;
            while mantissa & 0x0400 == 0 {
                mantissa <<= 1;
                shifts += 1;
            }
            let normalized = mantissa & 0x03ff;
            let exponent = 127_u32 - 14 - shifts;
            sign | (exponent << 23) | (normalized << 13)
        }
        0x1f => sign | 0x7f80_0000 | (fraction << 13),
        _ => sign | ((exponent + 112) << 23) | (fraction << 13),
    };
    f32::from_bits(f32_bits)
}

impl Bf16Rows {
    pub fn row_width(&self) -> usize {
        self.row_width
    }

    pub fn rows(&self) -> u64 {
        self.store.rows
    }

    pub fn read_f32_row(&mut self, row_id: u64, output: &mut [f32]) -> Result<()> {
        if output.len() != self.row_width {
            return Err(Error::Invalid("BF16 output row width mismatch"));
        }
        let bytes = self.store.read(row_id)?;
        for (value, pair) in output.iter_mut().zip(bytes.chunks_exact(2)) {
            let bits = u16::from_le_bytes([pair[0], pair[1]]);
            *value = f32::from_bits(u32::from(bits) << 16);
            if !value.is_finite() {
                return Err(Error::Invalid("BF16 row contains non-finite value"));
            }
        }
        Ok(())
    }

    pub fn stats(&self) -> Stats {
}

/// Applies a dense PyTorch-order linear projection `[out_features, in_features]`.
pub fn linear(input: &[f32], weight: &[f32], bias: Option<&[f32]>) -> Result<Vec<f32>> {
    if input.is_empty() || weight.is_empty() || !weight.len().is_multiple_of(input.len()) {
        return Err(Error::Invalid("linear projection shape mismatch"));
    }
    let output_size = weight.len() / input.len();
    if bias.is_some_and(|values| values.len() != output_size) {
        return Err(Error::Invalid("linear bias shape mismatch"));
    }
    finite(input)?;
    finite(weight)?;
    if let Some(bias) = bias {
        finite(bias)?;
    }
    let mut output = Vec::new();
    output
        .try_reserve_exact(output_size)
        .map_err(|_| Error::Capacity("linear output"))?;
    for row in 0..output_size {
        let start = row * input.len();
        let mut sum = weight[start..start + input.len()]
            .iter()
            .zip(input)
            .map(|(weight, input)| weight * input)
            .sum::<f32>();
        if let Some(bias) = bias {
            sum += bias[row];
        }
        output.push(sum);
    }
    finite(&output)?;
    Ok(output)
}

/// Supplies one output-feature row at a time for a bounded linear projection.
pub trait LinearWeightRows {
    fn output_features(&self) -> u64;
    fn input_features(&self) -> usize;
    fn read_weight_row(&mut self, row: u64, output: &mut [f32]) -> Result<()>;
}

/// Applies `[out_features, in_features]` weights without materializing the matrix.
pub fn linear_from_rows<R: LinearWeightRows>(
    input: &[f32],
    weights: &mut R,
    bias: Option<&[f32]>,
) -> Result<Vec<f32>> {
    let output_size = usize::try_from(weights.output_features()).map_err(|_| Error::Overflow)?;
    if input.is_empty()
        || output_size == 0
        || weights.input_features() != input.len()
        || bias.is_some_and(|values| values.len() != output_size)
    {
        return Err(Error::Invalid(
            "row-backed linear projection shape mismatch",
        ));
    }
    finite(input)?;
    if let Some(bias) = bias {
        finite(bias)?;
    }
    let mut weight_row = Vec::new();
    weight_row
        .try_reserve_exact(input.len())
        .map_err(|_| Error::Capacity("linear weight row"))?;
    weight_row.resize(input.len(), 0.0);
    let mut output = Vec::new();
    output
        .try_reserve_exact(output_size)
        .map_err(|_| Error::Capacity("linear output"))?;
    for row in 0..weights.output_features() {
        weights.read_weight_row(row, &mut weight_row)?;
        finite(&weight_row)?;
        let mut sum = weight_row
            .iter()
            .zip(input)
            .map(|(weight, input)| weight * input)
            .sum::<f32>();
        if let Some(bias) = bias {
            sum += bias[usize::try_from(row).map_err(|_| Error::Overflow)?];
        }
        output.push(sum);
    }
    finite(&output)?;
    Ok(output)
}

#[derive(Clone, Debug, PartialEq)]
pub struct GatedResidualOutput {
    pub mixed_input: Vec<f32>,
    pub hyper_input: Vec<f32>,
    /// One scale per residual stream; absent for the final combine-free mixer.
    pub injection_weights: Option<Vec<f32>>,
}

impl GatedResidualOutput {
    /// Adds a block result back into each original residual stream.
    pub fn inject(
        &self,
//! PLE embedding-row lookup with transactional n-gram history updates.

use crate::{
    config::QwenTextConfig,
    ngram::Ngram,
    reference::{ple_step, DepthwiseConvState, PleLayerWeights},
    rows::SafeTensorIndex,
    Error, Result,
};
use std::{
    collections::{HashMap, HashSet},
    path::{Path, PathBuf},
};

/// Opens the pinned text checkpoint's indexed PLE BF16 shards in numeric order.
/// `cache_bytes` is the aggregate encoded-row cache budget divided among shards.
pub fn open_qwen4exp_ple_rows(
    index_path: &Path,
    shard_directory: &Path,
    config: &QwenTextConfig,
    cache_bytes: usize,
) -> Result<ShardedEmbeddingRows<crate::rows::Bf16Rows>> {
    let shard_count = config.ngram_split_parts;
    if shard_count == 0 {
        return Err(Error::Invalid("Qwen PLE shard count is zero"));
    }
    let total_rows = crate::schema::ple_table_rows(config)?;
    if total_rows % shard_count != 0 {
        return Err(Error::Invalid(
            "Qwen PLE rows do not divide into source shards",
        ));
    }
    let rows_per_shard = total_rows / shard_count;
    let row_width = crate::schema::ple_row_width(config)?;
    let names = (0..shard_count)
        .map(|index| {
            format!(
                "model.language_model.layers.1.ple.ple_embedding.ngram_embedding.shard_{index}.weight"
            )
        })
        .collect::<Vec<_>>();
    open_indexed_bf16_shards(
        index_path,
        shard_directory,
        &names,
        [rows_per_shard, row_width],
        cache_bytes,
    )
}

/// Reads the three exact int64 PLE hash arrays through the checkpoint index.
/// These values are ready for a future GGUF integer-array metadata writer and
/// must not be converted to float tensor values.
pub fn open_qwen4exp_ple_hash_metadata(
    index_path: &Path,
    shard_directory: &Path,
    config: &QwenTextConfig,
) -> Result<Vec<crate::reference::source::ConvertedPleHashMetadata>> {
    use crate::reference::source::{
        transform_qwen4exp_i64_metadata, validate_qwen4exp_ple_hash_metadata,
    };

    let source_index = SafeTensorIndex::open(index_path, shard_directory)?;
    let head_count = config
        .ngram_size
        .checked_sub(1)
        .and_then(|sizes| sizes.checked_mul(config.heads_per_ngram))
        .ok_or(Error::Overflow)?;
    let vectors = [
        (
            "model.language_model.layers.1.ple.ple_embedding.layer_multipliers",
            config.ngram_size,
        ),
        (
            "model.language_model.layers.1.ple.ple_embedding.ngram_heads_offsets",
            head_count,
        ),
        (
            "model.language_model.layers.1.ple.ple_embedding.ngram_heads_vocab_sizes",
            head_count,
        ),
    ];
    let mut output = Vec::new();
    output
        .try_reserve_exact(vectors.len())
        .map_err(|_| Error::Capacity("PLE hash metadata arrays"))?;
    for (tensor_name, expected_len) in vectors {
        let file = source_index.open_tensor(tensor_name)?;
        let values = file.i64_vector(tensor_name, expected_len)?;
        output.push(transform_qwen4exp_i64_metadata(
            tensor_name,
            &[expected_len],
            &values,
            config,
        )?);
    }
    validate_qwen4exp_ple_hash_metadata(&output, config)?;
    Ok(output)
}

fn open_indexed_bf16_shards(
    index_path: &Path,
    shard_directory: &Path,
    tensor_names: &[String],
    expected_shape: [usize; 2],
    cache_bytes: usize,
) -> Result<ShardedEmbeddingRows<crate::rows::Bf16Rows>> {
    if tensor_names.is_empty() || expected_shape.contains(&0) {
        return Err(Error::Invalid("invalid indexed SafeTensors geometry"));
    }
    let source_index = SafeTensorIndex::open(index_path, shard_directory)?;
    let mut opened_files = HashMap::<PathBuf, crate::rows::SafeTensorFile>::new();
    let mut seen_names = HashSet::new();
    let mut shards = Vec::new();
    shards
        .try_reserve_exact(tensor_names.len())
        .map_err(|_| Error::Capacity("indexed PLE shard readers"))?;
    let cache_per_shard = cache_bytes / tensor_names.len();
    for tensor_name in tensor_names {
        if !seen_names.insert(tensor_name.as_str()) {
            return Err(Error::Invalid("duplicate tensor in SafeTensors shard list"));
        }
        let file_path = source_index.file_path(tensor_name)?;
        if !opened_files.contains_key(file_path) {
            opened_files.insert(
                file_path.to_path_buf(),
                source_index.open_tensor(tensor_name)?,
            );
        }
        let file = opened_files
            .get(file_path)
            .ok_or(Error::Invalid("SafeTensors shard was not opened"))?;
        let reader = file.bf16_rows(tensor_name, expected_shape, cache_per_shard)?;
        shards.push((
            u64::try_from(expected_shape[0]).map_err(|_| Error::Overflow)?,
            reader,
        ));
    }
    ShardedEmbeddingRows::new(shards, expected_shape[1])
}

/// Adapts independently verified row storage/decoding to the PLE lookup path.
pub trait EmbeddingRowReader {
    /// Fills one decoded embedding row. Implementations must write every value.
    fn read_row(&mut self, row_id: u64, output: &mut [f32]) -> Result<()>;
}

/// Presents ordered PLE source shards as one logical row table without
/// concatenating their payloads in memory.
pub struct ShardedEmbeddingRows<R> {
    shards: Vec<(u64, u64, R)>,
    row_width: usize,
    total_rows: u64,
}

impl<R> ShardedEmbeddingRows<R> {
    /// `shards` contains `(row_count, reader)` pairs in source concatenation
    /// order. Each reader is addressed with a shard-local row index.
    pub fn new(shards: Vec<(u64, R)>, row_width: usize) -> Result<Self> {
        if shards.is_empty() || row_width == 0 {
//! Small checked interface over the pinned GGUF metadata parser.
//!
//! This crate is intended for the isolated Qwen worker process. It does not
//! invoke llama.cpp model loading or architecture dispatch.

#![forbid(unsafe_op_in_unsafe_fn)]

#[cfg(feature = "cuda")]
mod cuda;

#[cfg(feature = "cuda")]
pub use cuda::{
    cuda_devices, cuda_f32_matvec, cuda_quantized_gguf_matvec, CudaDeviceInfo, CudaError,
};

use llama_cpp_sys_2 as ffi;
use std::{
    collections::{HashMap, HashSet},
    ffi::{CStr, CString},
    fmt,
    fs::{self, File, OpenOptions},
    io::{Read, Seek, SeekFrom},
    os::unix::fs::FileExt,
    path::{Path, PathBuf},
    ptr::{self, NonNull},
    sync::Arc,
    time::{SystemTime, UNIX_EPOCH},
};

const GGML_MAX_DIMS: usize = 4;
const GGML_TYPE_COUNT: i32 = ffi::GGML_TYPE_COUNT as i32;
const MAX_GGUF_BYTES: u64 = 512 * 1024 * 1024 * 1024;
const MAX_TENSORS: i64 = 1_000_000;
const MAX_METADATA_KEYS: i64 = 65_536;
const MAX_METADATA_STRING_BYTES: usize = 1024 * 1024;
const MAX_METADATA_COPY_BYTES: usize = 64 * 1024 * 1024;
const Q4_0_BLOCK_VALUES: usize = 32;
const Q4_0_BLOCK_BYTES: usize = 18;
const Q8_0_BLOCK_BYTES: usize = 34;
#[cfg(test)]
const K_BLOCK_VALUES: usize = 256;
const MAX_Q4_0_ROW_VALUES: usize = 16 * 1024 * 1024;
const MAX_DENSE_ROW_VALUES: usize = 16 * 1024 * 1024;
const IQ4_NL_VALUES: [i8; 16] = [
    -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113,
];

#[derive(Clone, Copy)]
enum RowQuantization {
    Q4_0,
    Iq4Nl,
    Q8_0,
    Native(i32),
}

impl RowQuantization {
    fn block_geometry(self) -> Result<(usize, usize), Error> {
        let (block_values, block_bytes) = match self {
            Self::Q4_0 | Self::Iq4Nl => (Q4_0_BLOCK_VALUES, Q4_0_BLOCK_BYTES),
            Self::Q8_0 => (Q4_0_BLOCK_VALUES, Q8_0_BLOCK_BYTES),
            Self::Native(ggml_type) => {
                if !(0..GGML_TYPE_COUNT).contains(&ggml_type) {
                    return Err(Error::Invalid("unknown native quantized GGML type"));
                }
                // SAFETY: the GGML type ID was checked against the pinned library.
                let block_values = unsafe { ffi::ggml_blck_size(ggml_type as ffi::ggml_type) };
                // SAFETY: the GGML type ID was checked against the pinned library.
                let block_bytes = unsafe { ffi::ggml_type_size(ggml_type as ffi::ggml_type) };
                (
                    usize::try_from(block_values)
                        .map_err(|_| Error::Invalid("invalid native quantized block width"))?,
                    block_bytes,
                )
            }
        };
        if block_values == 0 || block_bytes == 0 {
            return Err(Error::Invalid("invalid native quantized block geometry"));
        }
        Ok((block_values, block_bytes))
    }
}

/// Decode one GGML Q4_0 row into caller-owned FP32 values.
///
/// The input must contain exactly one complete row. This deliberately does not
/// read a tensor or allocate storage proportional to the full PLE table.
pub fn decode_q4_0_row(bytes: &[u8], row_width: usize) -> Result<Vec<f32>, Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid("Q4_0 row width outside supported geometry"));
    }
    let expected_bytes = (row_width / Q4_0_BLOCK_VALUES)
        .checked_mul(Q4_0_BLOCK_BYTES)
        .ok_or(Error::Invalid("Q4_0 row byte size overflow"))?;
    if bytes.len() != expected_bytes {
        return Err(Error::Invalid("Q4_0 row has unexpected byte length"));
    }
    let mut decoded = Vec::new();
    decoded
        .try_reserve_exact(row_width)
        .map_err(|_| Error::Invalid("cannot allocate decoded Q4_0 row"))?;
    decoded.resize(row_width, 0.0);
    decode_q4_0_row_into(bytes, row_width, &mut decoded)?;
    Ok(decoded)
}

/// Decode one GGML Q4_0 row directly into a caller-owned FP32 buffer.
pub fn decode_q4_0_row_into(
    bytes: &[u8],
    row_width: usize,
    decoded: &mut [f32],
) -> Result<(), Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid("Q4_0 row width outside supported geometry"));
    }
    if decoded.len() != row_width {
        return Err(Error::Invalid("Q4_0 output buffer has unexpected length"));
    }
    let block_count = row_width / Q4_0_BLOCK_VALUES;
    let expected_bytes = block_count
        .checked_mul(Q4_0_BLOCK_BYTES)
        .ok_or(Error::Invalid("Q4_0 row byte size overflow"))?;
    if bytes.len() != expected_bytes {
        return Err(Error::Invalid("Q4_0 row has unexpected byte length"));
    }

    let mut output_offset = 0;
    for block in bytes.chunks_exact(Q4_0_BLOCK_BYTES) {
        let scale = f16(u16::from_le_bytes([block[0], block[1]]));
        if !scale.is_finite() {
            return Err(Error::Invalid("Q4_0 row contains a non-finite scale"));
        }
        let quants = &block[2..];
        // GGML stores the first 16 values in the low nibbles and the next 16
        // values in the high nibbles, each centered by subtracting eight.
        for quant in quants.iter().take(16) {
            decoded[output_offset] = f32::from(i16::from(quant & 0x0f) - 8) * scale;
            output_offset += 1;
        }
        for quant in quants.iter().take(16) {
            decoded[output_offset] = f32::from(i16::from(quant >> 4) - 8) * scale;
            output_offset += 1;
        }
    }
    Ok(())
}

/// Decode one GGML IQ4_NL row using GGML's nonlinear 16-value codebook.
pub fn decode_iq4_nl_row(bytes: &[u8], row_width: usize) -> Result<Vec<f32>, Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid(
            "IQ4_NL row width outside supported geometry",
        ));
    }
    let mut decoded = Vec::new();
    decoded
        .try_reserve_exact(row_width)
        .map_err(|_| Error::Invalid("cannot allocate decoded IQ4_NL row"))?;
    decoded.resize(row_width, 0.0);
    decode_iq4_nl_row_into(bytes, row_width, &mut decoded)?;
    Ok(decoded)
}

pub fn decode_iq4_nl_row_into(
    bytes: &[u8],
    row_width: usize,
    decoded: &mut [f32],
) -> Result<(), Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid(
            "IQ4_NL row width outside supported geometry",
        ));
    }
    if decoded.len() != row_width || bytes.len() != (row_width / 32) * 18 {
        return Err(Error::Invalid("IQ4_NL row buffer has unexpected length"));
    }
    for (block_index, block) in bytes.chunks_exact(18).enumerate() {
        let scale = f16(u16::from_le_bytes([block[0], block[1]]));
        if !scale.is_finite() {
            return Err(Error::Invalid("IQ4_NL row contains a non-finite scale"));
        }
        let base = block_index * 32;
        for j in 0..16 {
            decoded[base + j] = scale * f32::from(IQ4_NL_VALUES[usize::from(block[j + 2] & 0x0f)]);
            decoded[base + j + 16] =
                scale * f32::from(IQ4_NL_VALUES[usize::from(block[j + 2] >> 4)]);
        }
    }
    Ok(())
}

/// Decode one GGML Q8_0 row into a caller-owned FP32 buffer.
pub fn decode_q8_0_row(bytes: &[u8], row_width: usize) -> Result<Vec<f32>, Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid("Q8_0 row width outside supported geometry"));
    }
    let mut decoded = Vec::new();
    decoded
        .try_reserve_exact(row_width)
        .map_err(|_| Error::Invalid("cannot allocate decoded Q8_0 row"))?;
    decoded.resize(row_width, 0.0);
    decode_q8_0_row_into(bytes, row_width, &mut decoded)?;
    Ok(decoded)
}

/// Decode one GGML Q8_0 row directly into a caller-owned FP32 buffer.
pub fn decode_q8_0_row_into(
    bytes: &[u8],
    row_width: usize,
    decoded: &mut [f32],
) -> Result<(), Error> {
    if row_width == 0
        || row_width > MAX_Q4_0_ROW_VALUES
        || row_width.checked_rem(Q4_0_BLOCK_VALUES) != Some(0)
    {
        return Err(Error::Invalid("Q8_0 row width outside supported geometry"));
    }
    if decoded.len() != row_width {
        return Err(Error::Invalid("Q8_0 output buffer has unexpected length"));
    }
    let block_count = row_width / Q4_0_BLOCK_VALUES;
    let expected_bytes = block_count
        .checked_mul(Q8_0_BLOCK_BYTES)
        .ok_or(Error::Invalid("Q8_0 row byte size overflow"))?;
    if bytes.len() != expected_bytes {
        return Err(Error::Invalid("Q8_0 row has unexpected byte length"));
    }
    for (block_index, block) in bytes.chunks_exact(Q8_0_BLOCK_BYTES).enumerate() {
        let scale = f16(u16::from_le_bytes([block[0], block[1]]));
        if !scale.is_finite() {
            return Err(Error::Invalid("Q8_0 row contains a non-finite scale"));
        }
        let base = block_index * Q4_0_BLOCK_VALUES;
        for (index, quantized) in block[2..].iter().enumerate() {
            decoded[base + index] = scale * f32::from(i8::from_le_bytes([*quantized]));
        }
        let end = data_offset
            .checked_add(tensor_bytes)
            .ok_or(Error::Invalid("quantized tensor extent overflow"))?;
        if file.metadata()?.len() != info.file_size || end > info.file_size {
            return Err(Error::Invalid(
                "GGUF file changed after quantized metadata inspection",
            ));
        }
        Ok(Self {
            file,
            data_offset,
            rows,
            rows_per_group,
            groups,
            row_width,
            row_bytes,
            quantization,
        })
    }

    pub fn row_count(&self) -> u64 {
        self.rows
    }

    pub fn row_width(&self) -> usize {
        self.row_width
    }

    /// Rows along GGUF dimension one, useful for slicing stacked experts.
    pub fn rows_per_group(&self) -> u64 {
        self.rows_per_group
    }

    /// Number of groups in GGUF dimensions two and above.
    pub fn group_count(&self) -> u64 {
        self.groups
    }

    /// Reads and decodes only the requested row.
    pub fn read_row(&self, row: u64) -> Result<Vec<f32>, Error> {
        let mut output = Vec::new();
        output
            .try_reserve_exact(self.row_width)
            .map_err(|_| Error::Invalid("cannot allocate quantized row output"))?;
        output.resize(self.row_width, 0.0);
        self.read_row_into(row, &mut output)?;
        Ok(output)
    }

    /// Reads and decodes one row into a caller-owned buffer.
    pub fn read_row_into(&self, row: u64, output: &mut [f32]) -> Result<(), Error> {
        if row >= self.rows {
            return Err(Error::Invalid("quantized row index outside tensor"));
        }
        if output.len() != self.row_width {
            return Err(Error::Invalid(
                "quantized output buffer has unexpected length",
            ));
        }
        let offset = u64::try_from(self.row_bytes)
            .ok()
            .and_then(|row_bytes| row.checked_mul(row_bytes))
            .and_then(|relative| self.data_offset.checked_add(relative))
            .ok_or(Error::Invalid("quantized row offset overflow"))?;
        let mut bytes = Vec::new();
        bytes
            .try_reserve_exact(self.row_bytes)
            .map_err(|_| Error::Invalid("cannot allocate quantized row buffer"))?;
        bytes.resize(self.row_bytes, 0);
        self.file.read_exact_at(&mut bytes, offset)?;
        match self.quantization {
            RowQuantization::Q4_0 => decode_q4_0_row_into(&bytes, self.row_width, output),
            RowQuantization::Iq4Nl => decode_iq4_nl_row_into(&bytes, self.row_width, output),
            RowQuantization::Q8_0 => decode_q8_0_row_into(&bytes, self.row_width, output),
            RowQuantization::Native(ggml_type) => {
                decode_native_quantized_row_into(ggml_type, &bytes, output)
            }
        }
    }
}

impl agentix_qwen::ple::EmbeddingRowReader for QuantizedRows {
    fn read_row(&mut self, row_id: u64, output: &mut [f32]) -> agentix_qwen::Result<()> {
        self.read_row_into(row_id, output)
            .map_err(|_| agentix_qwen::Error::Invalid("GGUF PLE row read or decode failed"))
    }
}

