54:pub fn open_qwen4exp_ple_hash_metadata(
    // The copied input has u64 alignment for GGML's block structs.
    unsafe {
        let traits = ggml_get_type_traits(ggml_type);
        if traits.is_null() {
            return Err(Error::Invalid("native GGML type traits are unavailable"));
        }
        let to_float = (*traits)
            .to_float
            .ok_or(Error::Invalid("native GGML type has no row decoder"))?;
        to_float(aligned_bytes.as_ptr().cast(), output.as_mut_ptr(), width);
    }
    if output.iter().all(|value| value.is_finite()) {
        Ok(())
    } else {
        Err(Error::Invalid("quantized row decoded to non-finite values"))
//! PLE embedding-row lookup with transactional n-gram history updates.

use crate::{
    config::QwenTextConfig,
    ngram::Ngram,
    reference::{ple_step, DepthwiseConvState, PleLayerWeights},
    rows::SafeTensorIndex,
    Error, Result,
};
use std::{
    collections::{HashMap, HashSet},
    path::{Path, PathBuf},
};

/// Opens the pinned text checkpoint's indexed PLE BF16 shards in numeric order.
/// `cache_bytes` is the aggregate encoded-row cache budget divided among shards.
pub fn open_qwen4exp_ple_rows(
    index_path: &Path,
    shard_directory: &Path,
    config: &QwenTextConfig,
    cache_bytes: usize,
) -> Result<ShardedEmbeddingRows<crate::rows::Bf16Rows>> {
    let shard_count = config.ngram_split_parts;
    if shard_count == 0 {
        return Err(Error::Invalid("Qwen PLE shard count is zero"));
    }

