+#[test]
+fn reservation_overflow_preserves_admission_error_order() -> TestResult {
+    let empty = Reservations::default();
+    let full = Reservations {
+        weights: u64::MAX - 5,
+        context: 1,
+        scratch: 1,
+        staging: 1,
+        lookup_cache: 1,
+        headroom: 1,
+    };
+    assert_eq!(empty.total()?, 0);
+    assert_eq!(full.total()?, u64::MAX);
+    let admitted = admit(u64::MAX, u64::MAX, full, full)?;
+    assert_eq!(admitted.host_remaining, 0);
+    assert_eq!(admitted.device_remaining, 0);
+
+    let overflow = Reservations {
+        headroom: 2,
+        ..full
+    };
+    assert!(matches!(overflow.total(), Err(Error::Overflow)));
+    assert!(matches!(
+        admit(u64::MAX, u64::MAX, overflow, empty),
+        Err(Error::Overflow)
+    ));
+    assert!(matches!(
+        admit(u64::MAX, u64::MAX, empty, overflow),
+        Err(Error::Overflow)
+    ));
+    assert!(matches!(
+        admit(0, u64::MAX, full, overflow),
+        Err(Error::Capacity("host RAM"))
+    ));
+    assert!(matches!(
+        admit(0, 0, overflow, full),
+        Err(Error::Overflow)
+    ));
+    Ok(())
+}
